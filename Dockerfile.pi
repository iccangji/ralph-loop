# Docker CLI and compose plugin, copied from the pinned upstream image. Ralph
# mounts the host socket, so the agent drives the host daemon directly.
FROM docker:27.5.1-cli AS dockercli

FROM node:24-bookworm-slim

ARG PI_VERSION=1.5.2

# Tooling the loop needs inside the container. Ralph runs as the host UID/GID,
# so nothing can be installed at runtime: everything must be baked in here.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    ripgrep \
    unzip \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}"

COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose \
  /usr/local/libexec/docker/cli-plugins/docker-compose

# Writable home and agent dir for the mapped host user
RUN mkdir -p /home/pi /pi-agent /pi-config \
  && chmod 0777 /home/pi /pi-agent /pi-config

COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV HOME=/home/pi
WORKDIR /home/pi
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
