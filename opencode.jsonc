{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/combo1",
  "default_agent": "build",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sudo rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sudo rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /tmp*", "effect": "allow" },
    { "action": "shell", "resource": "sudo rm -rf /tmp*", "effect": "allow" }
  ]
}
