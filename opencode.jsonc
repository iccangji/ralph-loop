{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/combo1",
  "default_agent": "factory-lead",
  "agents": {
    "factory-lead": { "model": "9router/combo1" },
    "researcher": { "model": "9router/combo1" },
    "coder": { "model": "9router/combo1" },
